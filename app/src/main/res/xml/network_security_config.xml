<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app talks only to the three provider APIs; cleartext is blocked. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
